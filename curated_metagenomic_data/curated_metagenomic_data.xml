        </param>
    </inputs>

    <outputs>
        <data name="count_data" format="tabular" label="${name} Count Data (TSV)"/>
        <data name="metadata" format="tabular" label="${name} Metadata (TSV)"/>
    </outputs>

    <tests>
        <test>
            <param name="name" value="OhJ_2014" />
            <output name="count_data" file="merged_data.tsv"/>
            <output name="metadata" file="metadata.tsv"/>
        </test>
    </tests>
    <help><![CDATA[

        This tool returns curated microbiome data as TSV files.
        
        Usage:
        - Select a dataset from the dropdown menu.
        - The tool will output two files:
            - Count Data: Tab-separated values file containing microbiome counts.
            - Metadata: Tab-separated values file containing sample metadata.
        
        The curatedMetagenomicData package provides access to standardized, curated human microbiome datasets for advanced analysis and research.

    ]]></help>
